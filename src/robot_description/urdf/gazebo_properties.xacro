<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>base_left_back_wheel_joint</left_joint>
            <right_joint>base_right_back_wheel_joint</right_joint>
            <wheel_separation>0.6355</wheel_separation>
            <wheel_radius>0.1687</wheel_radius>
            <max_linear_acceleration>2.5</max_linear_acceleration>
            <min_linear_acceleration>-2.5</min_linear_acceleration>
            <max_angular_acceleration>2.0</max_angular_acceleration>
            <min_angular_acceleration>-2.0</min_angular_acceleration>
            <max_linear_velocity>1.5</max_linear_velocity>
            <min_linear_velocity>-0.5</min_linear_velocity>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>10</odom_publish_frequency>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_back_wheel_joint</joint_name>
            <joint_name>base_right_back_wheel_joint</joint_name>
            <joint_name>al_profile_connector_joint</joint_name>
            <joint_name>al_profile2_joint</joint_name>
            <topic>/joint_states</topic>
            <update_rate>10</update_rate>
        </plugin>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <topic>/camera/image_raw</topic>
            <update_rate>30</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
            <joint_name>al_profile_connector_joint</joint_name>
            <topic>/slider_z_cmd</topic>
            <p_gain>10000</p_gain>
            <i_gain>100</i_gain>
            <d_gain>1000</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
            <joint_name>al_profile2_joint</joint_name>
            <topic>/slider_x_cmd</topic>
            <p_gain>10000</p_gain>
            <i_gain>100</i_gain>
            <d_gain>1000</d_gain>
        </plugin>
    </gazebo>

    <!-- ============================================================ -->
    <!-- Wheel friction                                                -->
    <!-- ============================================================ -->
    <gazebo reference="left_back_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="right_back_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!-- Low friction caster for smooth turning -->
    <gazebo reference="caster_wheel">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
        <kp>500000.0</kp>
        <kd>10.0</kd>
    </gazebo>

    <!-- Base link visual colour in Gazebo -->
    <gazebo reference="base_link">
        <material>
            <ambient>0.0 0.6 0.0 1</ambient>
            <diffuse>0.0 0.6 0.0 1</diffuse>
        </material>
    </gazebo>

</robot>
