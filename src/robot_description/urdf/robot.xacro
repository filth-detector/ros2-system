<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- use_sim:=true switches wheel joints to 'continuous' and adds Gazebo plugins -->
    <xacro:arg name="use_sim" default="false"/>
    <xacro:property name="sim_mode" value="$(arg use_sim)"/>

    <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/mobile_base.xacro" />

    <!-- Gazebo (only when building for simulation) -->
    <xacro:if value="${sim_mode}">
        <xacro:include filename="$(find robot_description)/urdf/gazebo_properties.xacro" />
    </xacro:if>

</robot>